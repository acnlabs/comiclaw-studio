generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // Pooler URL — used by Vercel serverless at runtime
  directUrl = env("DIRECT_URL")         // Direct URL — used by prisma migrate at build time
}

// ---------- 栏目(连续主题容器,如《AI 漫记》) ----------

// 轻量父层:统一主题下挂多记 Project。可选绑定 ACN Org(可与其它栏目共用)。
model Column {
  id          String   @id @default(cuid())
  slug        String   @unique // URL 友好标识,如 ai-journal
  name        String // 栏目名,如「AI 漫记」
  description String?
  coverUrl    String?
  // 创建者 Auth0 sub;官方栏目可为空(Studio key 代建)
  ownerUserId String?
  // 栏目的编辑 agent(如《AI 漫记》的 comiclaw)。它可以用自己的 ACN 身份开一记,
  // 不必持有全权的 STUDIO_API_KEY——把运维密钥交给一个会被 prompt 影响的 agent
  // 是不对的,而没有它日更的第一步就走不通。
  editorAgentId String?
  // 可选默认协作组织(ACN Org);非唯一——多栏目可挂同一 Org
  acnOrgId    String?
  acnSubnetId String? // Org fence subnet 镜像,便于展示
  // 用户自助建 Org 的领取时间;按人日限额按「尝试」计数,避免外部建成后本地失败不计
  orgCreatedAt DateTime?
  // org_members = 有生效 Org 时 agent 须为成员;open = 谁都能投;owner_only = 仅治理人
  contributePolicy String @default("org_members")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]
  orgJoinRequests OrgJoinRequest[]
  seriesWork Work?

  @@index([updatedAt])
  @@index([acnOrgId])
  @@index([ownerUserId])
  @@index([ownerUserId, orgCreatedAt])
}

// 栏目共创 Org 加入申请(ACN 侧加人需治理方;Studio 代收申请,运维用 Studio key 批准后由 steward key 调 ACN)
model OrgJoinRequest {
  id        String   @id @default(cuid())
  acnOrgId  String
  agentId   String
  columnId  String?
  // pending | approving | approved | rejected
  status    String   @default("pending")
  note      String? // agent 申请备注(勿被拒绝理由覆盖)
  decisionNote String? // 运维批准/拒绝附言
  decidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  column Column? @relation(fields: [columnId], references: [id], onDelete: SetNull)

  @@unique([acnOrgId, agentId])
  @@index([acnOrgId, status])
  @@index([columnId])
}

// ---------- 项目 ----------

// 工作流固定五阶段:剧本 -> 资产 -> 分镜 -> 成片 -> 发行
// 阶段不建表,作为项目上的状态字段
model Project {
  id          String   @id @default(cuid())
  shareToken  String   @unique @default(cuid()) // 客户免登录访问令牌
  name        String // 项目名,如「XX智能体 15s 宣传短视频」
  clientName  String? // 客户名称
  agentName   String? // 被宣传的智能体名称
  description String?
  coverUrl    String? // 项目封面图
  ownerUserId String? // 东家是人时的 Auth0 sub
  // 创建时定东家:user | agent | org。acnOrgId 只是协作围栏,不等于组织拥有。
  ownerKind    String  @default("user")
  ownerAgentId String?
  ownerOrgId   String?
  // PRIVATE = 客户制作单(默认);PUBLIC = 开放共创(如《AI 漫记》一记)
  visibility  String   @default("PRIVATE") // PRIVATE | PUBLIC
  isPrivate   Boolean @default(false) // 私密模式:仅对 PRIVATE 项目生效;PUBLIC 必须为 false
  // 可选归属栏目;entryOrder = 栏目内第 N 记(可空;公开时间线 newest-first 且 nulls last,再按 createdAt desc)
  columnId    String?
  entryOrder  Int?
  // 一记是横向的:官方项目为锚(parentProjectId 为空、带 entryOrder),
  // 其他创作者基于这一记做的二创 / 共创各自成项目挂在锚下,归各自所有。
  // 只允许一层,二创之下不再分叉
  parentProjectId String?
  // 可选覆盖栏目默认 Org;独立开放项目也可直接挂 Org
  acnOrgId    String?
  // 空=继承栏目策略 / 默认 org_members
  contributePolicy String?
  // VIDEO = 短视频(或漫剧里的一集);DRAMA = 漫剧壳,下面挂集,自己不走成片流水线
  format String @default("VIDEO")
  // 集所属的漫剧壳;dramaOrder = 第 N 集(与栏目 entryOrder 分开,两种容器不混)
  dramaProjectId String?
  dramaOrder     Int?
  statusNote  String? // 实时状态(agent 推送,如「正在生成分镜 3/9…」),阶段完成后清空
  currentStage String  @default("SCRIPT") // SCRIPT | ASSETS | STORYBOARD | FILM | RELEASE | DONE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  column            Column? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  // 删锚点会带走整记的二创,所以删除处显式拦截,不靠级联
  parentProject   Project?  @relation("EntryProjects", fields: [parentProjectId], references: [id], onDelete: Restrict)
  derivedProjects Project[] @relation("EntryProjects")
  dramaProject    Project?  @relation("DramaEpisodes", fields: [dramaProjectId], references: [id], onDelete: Restrict)
  dramaEpisodes   Project[] @relation("DramaEpisodes")
  scriptVersions ScriptVersion[]
  assets         Asset[]
  shots          Shot[]
  filmVersions   FilmVersion[]
  releases       Release[]
  work           Work?
  seriesWorkId   String?
  seriesWork     Work?     @relation("ProjectSeriesWork", fields: [seriesWorkId], references: [id], onDelete: SetNull)
  // 漫剧壳对应的发现系列;和成片的 Work.projectId 分开,避免壳上误出片把剧覆盖成短视频
  dramaSeriesWork Work?    @relation("DramaSeriesWork")
  comments       Comment[]
  castingLicenses CastingLicense[]
  assetLicenses   AssetLicense[]
  generationCharges GenerationChargeRef[]
  acnTaskRefs       AcnTaskRef[]

  @@index([ownerUserId])
  @@index([ownerKind, ownerAgentId])
  @@index([ownerKind, ownerOrgId])
  @@index([visibility, updatedAt])
  @@index([columnId, entryOrder])
  @@unique([columnId, entryOrder])
  @@index([parentProjectId])
  @@index([acnOrgId])
  @@index([seriesWorkId])
  @@index([format])
  @@index([dramaProjectId, dramaOrder])
  @@unique([dramaProjectId, dramaOrder])
}

// ---------- ACN 生产任务映射(编排在 ACN,Studio 只记指针) ----------

// 任务状态机在 ACN Task Pool(create/accept/submit);钱走 AgentPlanet
// /wallet/charge。这里只存 acnTaskId ↔ projectId,外加入参快照便于排障/
// 交付物回写,不维护 QUEUED/RUNNING 本地状态机。
model AcnTaskRef {
  id        String   @id @default(cuid())
  acnTaskId String   @unique // ACN task_id
  projectId String
  type      String // WRITE_SCRIPT | GENERATE_IMAGE
  input     Json? // 建单时的入参快照(brief / prompt 等)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([type, createdAt])
}

// ---------- 剧本 ----------

model ScriptVersion {
  id        String   @id @default(cuid())
  projectId String
  version   Int // 同一 authorKey 下从 1 递增
  title     String?
  logline   String? // 一句话梗概
  content   String // 剧本正文(Markdown,分场)
  changeLog String? // 本版改动说明
  // 作者:人类 user:<sub> / agent agent:<id> / 遗留 legacy
  authorUserId  String?
  authorAgentId String?
  authorKey     String   @default("legacy")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, authorKey, version])
  @@index([authorUserId])
  @@index([authorAgentId])
}

// ---------- 资产(角色/场景/道具) ----------

model Asset {
  id          String   @id @default(cuid())
  // 可空:资产不一定属于某个项目。角色市场里直接建的角色没有来源项目,登记与
  // 交易照常进行,只是没有容器可以继承权限——这类资产的权限只能来自它自己
  // (作者可改删,登记产权人可发布/定价/转让)。
  projectId   String?
  type        String // CHARACTER | SCENE | PROP
  name        String
  description String?
  authorUserId  String?
  authorAgentId String?
  authorKey     String   @default("legacy")
  // 发布为可交易资产后的产权主体,对应 AgentPlanet 登记表 owner_type/owner_id
  // (user | agent | org;org 用 ACN org_id)。未发布时为空。
  ownerType   String?
  ownerId     String?
  // 定妆版本:交易的是这一版,不随后续抽卡改变
  publishedVersionId String?
  publishedAt        DateTime?
  // draft | publishing | published | unpublishing
  // 单独一个状态位:publishedAt 无法区分「正在登记」和「已登记」,并发撤销会把
  // 还在登记中的资产注销掉
  publishState       String    @default("draft")
  // 使用权定价:0 = 免费授权。> 0 时在 AgentPlanet Store 上架成商品,卖家必须
  // 与登记表产权人一致,所以产权一变(转让)就要换卖家重新上架。
  licensePoints  Int     @default(0)
  storeProductId String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions AssetVersion[] @relation("AssetVersions")
  licenses AssetLicense[]
  character AgentCharacter? @relation("CharacterAsset")
  publishedVersion AssetVersion? @relation("AssetPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  shotRefs ShotAsset[]

  @@index([projectId, authorKey])
  @@index([authorUserId])
  @@index([authorAgentId])
  @@index([publishedAt])
  @@index([publishState])
  @@index([ownerType, ownerId])
}

model AssetVersion {
  id        String   @id @default(cuid())
  assetId   String
  version   Int
  imageUrl  String // 设定图
  audioUrl  String? // 音色试听(角色资产的声音样本)
  notes     String? // 本版设计说明
  createdAt DateTime @default(now())

  asset Asset @relation("AssetVersions", fields: [assetId], references: [id], onDelete: Cascade)
  publishedFor Asset[] @relation("AssetPublishedVersion")

  @@unique([assetId, version])
}

// ---------- 分镜 ----------

model Shot {
  id              String   @id @default(cuid())
  projectId       String
  order           Int // 同一 authorKey 下镜头序号,从 1 开始
  title           String? // 镜头名,如「开场:LOGO 浮现」
  duration        Float? // 时长(秒)
  dialogue        String? // 台词 / 旁白
  action          String? // 画面描述
  prompt          String? // 生成提示词(输入侧,供专业用户查看与追溯)
  selectedVersion Int? // 客户选定的候选版本(抽卡选片)
  authorUserId    String?
  authorAgentId   String?
  authorKey       String   @default("legacy")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  ShotVersion[]
  assetRefs ShotAsset[]

  @@unique([projectId, authorKey, order])
  @@index([authorUserId])
  @@index([authorAgentId])
}

model ShotVersion {
  id        String   @id @default(cuid())
  shotId    String
  version   Int
  mediaUrl  String // 画面(图或视频片段)
  mediaType String   @default("IMAGE") // IMAGE | VIDEO
  notes     String?
  createdAt DateTime @default(now())

  shot Shot @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@unique([shotId, version])
}

// 分镜引用的资产
model ShotAsset {
  shotId  String
  assetId String

  shot  Shot  @relation(fields: [shotId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([shotId, assetId])
}

// ---------- 成片 ----------

model FilmVersion {
  id        String   @id @default(cuid())
  projectId String
  version   Int // 同一 authorKey 下从 1 递增
  videoUrl  String
  duration  Float? // 秒
  notes     String? // 本版剪辑说明
  authorUserId  String?
  authorAgentId String?
  authorKey     String   @default("legacy")
  // 二创:基于同项目内另一成片(不修改原作)
  basedOnFilmVersionId String?
  createdAt DateTime @default(now())

  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  basedOnFilmVersion FilmVersion?  @relation("FilmDerivative", fields: [basedOnFilmVersionId], references: [id], onDelete: SetNull)
  derivatives        FilmVersion[] @relation("FilmDerivative")
  comments           Comment[]

  @@unique([projectId, authorKey, version])
  @@index([authorUserId])
  @@index([authorAgentId])
  @@index([basedOnFilmVersionId])
}

// ---------- 时间码批注 ----------

// 客户对成片版本的时间码反馈(Frame.io 式);agent 拉取后精确返工
model Comment {
  id            String   @id @default(cuid())
  projectId     String
  filmVersionId String
  timecode      Float? // 秒;空表示针对整版的整体意见
  content       String
  authorSub     String // 发表者的 AgentPlanet 账号(Auth0 sub)
  authorName    String? // 展示名
  status        String   @default("OPEN") // OPEN | RESOLVED
  createdAt     DateTime @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filmVersion FilmVersion @relation(fields: [filmVersionId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// ---------- 智能体角色(数字人名录 / 选角市场) ----------

// 独立于项目的数字人角色,可复用:主演自己的宣传片、参演他人短剧。
// 两种来源:comiclaw 直接创建数字人 / 从项目资产发布。
model AgentCharacter {
  id          String   @id @default(cuid())
  name        String // 角色名 / 数字人名
  tagline     String? // 一句话简介
  persona     String? // 人设描述
  styleTags   String? // 风格标签,逗号分隔(如「写实,都市,专业」)
  imageUrl      String // 主形象图
  audioUrl      String? // 音色试听
  gallery       String? // 附加形象图 URL,逗号分隔(多视图/变装)
  introVideoUrl String? // 角色介绍视频(数字人可视化交互展示)

  // 关联的 ACN 智能体信息(第一步由创建方传入,后续可自动拉取)
  acnAgentId    String? // ACN agent_id
  agentName     String? // 智能体名称
  agentSummary  String? // 智能体简介
  agentUrl      String? // 智能体主页(AgentPlanet / 官网)

  ownerUserId     String? // 所属客户(Auth0 sub)
  sourceProjectId String? // 来源项目(从资产发布时填写;直接创建为空)
  // 可交易主体:角色的产权登记与上架都以这条 Asset 为准。角色表保留人设、
  // 出镜 Agent、是否公开这些「角色特有」的字段,不再自己充当登记主体
  // (同一个 comiclaw:character:* 命名空间下曾经并存两套 id)。
  assetId         String? @unique
  isPublic        Boolean @default(true) // 是否在角色市场公开
  openForCasting  Boolean @default(false) // 是否开放参演他人作品
  licensePoints   Int     @default(0) // 授权费(AgentPlanet Credits/项目);0 = 免费授权
  storeProductId  String? // AgentPlanet Store 的 agent_asset 商品 id(付费角色上架后回填)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset       Asset?           @relation("CharacterAsset", fields: [assetId], references: [id], onDelete: SetNull)
  castIn      WorkCast[]
  appearances WorkAppearance[]
  licenses    CastingLicense[]

  @@index([isPublic])
  @@index([ownerUserId])
}

// 选角授权:把角色市场的数字人授权给某个项目使用。
// 免费角色即时授予;付费角色经 AgentPlanet Store 扣 Credits 后授予,
// 收益(扣平台佣金后)进角色所属智能体的钱包。
model CastingLicense {
  id           String   @id @default(cuid())
  characterId  String
  projectId    String
  licenseeSub  String // 发起授权的客户(Auth0 sub)
  points       Int      @default(0) // 成交 Credits(快照)
  status       String   @default("GRANTED") // GRANTED | PENDING_PAYMENT
  storeOrderId String?  @unique // AgentPlanet Store 订单 id(付费授权)
  createdAt    DateTime @default(now())

  character AgentCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([characterId, projectId])
}

// 已发布资产的授权:把别人已登记的资产用到自己项目里。
// CastingLicense 只管 AgentCharacter,场景/道具登记了也没法用,所以另起一张按
// 资产走的表。points / storeOrderId 先留好,付费授权不必再迁一次库。
model AssetLicense {
  id           String   @id @default(cuid())
  assetId      String // 被授权的已发布资产
  projectId    String // 使用它的项目(授权方的项目)
  licenseeSub  String // 发起授权的客户(Auth0 sub)
  points       Int      @default(0) // 成交 Credits 快照;免费为 0
  status       String   @default("GRANTED") // GRANTED | PENDING_PAYMENT
  storeOrderId String?  @unique
  createdAt    DateTime @default(now())

  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([assetId, projectId])
  @@index([licenseeSub, status])
}

// 参演关系:作品 ↔ 角色(主演/参演)
model WorkCast {
  workId      String
  characterId String

  work      Work           @relation(fields: [workId], references: [id], onDelete: Cascade)
  character AgentCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([workId, characterId])
}

// 参演智能体:片子里的「演员」,主体是 agent 身份,角色图只是这身妆。
// appearingAgentId 仍是领衔 / Launch 出镜,这一张是完整演员表。
model WorkAppearance {
  workId      String
  agentId     String
  characterId String?
  role        String   @default("cast") // lead | cast
  displayName String?
  createdAt   DateTime @default(now())

  work      Work            @relation(fields: [workId], references: [id], onDelete: Cascade)
  character AgentCharacter? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@id([workId, agentId])
  @@index([agentId])
}

// 片子上的智能体署名:参演是出镜,其余是创作分工。同一人可兼几项。
model WorkCredit {
  workId      String
  agentId     String
  kind        String // appear | script | asset | storyboard | film
  role        String? // appear 时 lead | cast
  displayName String?
  createdAt   DateTime @default(now())

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([workId, agentId, kind])
  @@index([agentId])
}

// 上架/名单变更时给这个 agent 发过 ACN 通知。跟署名行分开,replace credits 不会抹掉。
model WorkCreditNotify {
  workId  String
  agentId String
  sentAt  DateTime @default(now())

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([workId, agentId])
}

// ---------- 平台作品(推荐 / 短剧) ----------

// 发行完成的内容回流为平台作品;短剧可含多集
model Work {
  id          String   @id @default(cuid())
  kind        String // VIDEO(短视频) | SERIES(短剧)
  category    String? // 短剧子类,目前仅「漫剧」
  title       String
  description String?
  coverUrl    String?
  videoUrl    String? // VIDEO 类作品的正片
  authorName  String? // 展示名,不当身份
  ownerKind    String? // user | agent | org;上架时从项目抄过来
  ownerUserId  String?
  ownerAgentId String?
  ownerOrgId   String?
  appearingAgentId String? // 片里的人 / 关于谁;可与东家不同
  projectId   String?  @unique // 来源 studio 项目(同步发布时填写)
  // 来源专栏:把该栏目各记的成片合成一个系列。这类作品是已入流作品的聚合视图,
  // 不再单独进推荐流,否则同一支视频会重复出现
  columnId    String?  @unique
  // 来源漫剧壳:同上,和 projectId 分开,成片只挂在各集上
  dramaProjectId String? @unique
  // 官方推荐:运维置顶的时刻。空 = 未推荐
  featuredAt  DateTime?
  publishedAt DateTime @default(now())

  project  Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column   Column?    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  dramaShow Project?  @relation("DramaSeriesWork", fields: [dramaProjectId], references: [id], onDelete: Cascade)
  episodes Episode[] @relation("SeriesEpisodes")
  // 专栏选集里的一集若来自已发布的短视频,指向那条 Work,评论跟它走
  sourcedEpisodes Episode[] @relation("EpisodeSourceWork")
  episodeProjects Project[] @relation("ProjectSeriesWork")
  cast        WorkCast[]
  appearances WorkAppearance[]
  credits     WorkCredit[]
  creditNotifies WorkCreditNotify[]
  plays       WorkPlay[]
  signals     WorkSignal[]

  @@index([featuredAt])
  @@index([ownerKind, ownerUserId])
  @@index([ownerKind, ownerAgentId])
  @@index([ownerKind, ownerOrgId])
  @@index([appearingAgentId])
}

// 人类公开主页的短名。Agent / Org 用 ACN id,不走这张表。
model UserProfile {
  userId      String   @id // Auth0 sub
  handle      String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 观看事件。「实时有热度」只能从真实观看里算,而这类数据不记就补不回来,
// 所以先开始记,排序规则可以以后再调。
model WorkPlay {
  id String @id @default(cuid())

  workId String
  // 匿名会话(HttpOnly cookie)。同一会话对同一作品在同一小时内只算一次,
  // 循环播放和来回滚动因此刷不出热度
  sessionKey String
  // 来源网络的加盐哈希。cookie 由调用方决定发不发,不发就每次都像新访客,
  // 所以还要按网络封顶——这一项调用方控制不了
  networkHash String?
  // 登录用户的 Auth0 sub。匿名观看保持空;热度不依赖这一列
  userId      String?
  hourBucket  DateTime
  createdAt   DateTime @default(now())

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, sessionKey, hourBucket])
  @@index([workId, networkHash, hourBucket])
  @@index([workId, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// 划走 / 完播。先记下来,排序以后再用;不计入热度。
model WorkSignal {
  id String @id @default(cuid())

  workId      String
  sessionKey  String
  userId      String?
  // skip | complete
  kind        String
  networkHash String?
  hourBucket  DateTime
  createdAt   DateTime @default(now())

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, sessionKey, kind, hourBucket])
  @@index([workId, kind, createdAt])
  @@index([userId, kind, createdAt])
  @@index([workId, networkHash, kind, hourBucket])
}

model Episode {
  id           String  @id @default(cuid())
  workId       String
  sourceWorkId String?
  order        Int
  title        String?
  videoUrl     String
  duration     Float?

  work       Work  @relation("SeriesEpisodes", fields: [workId], references: [id], onDelete: Cascade)
  sourceWork Work? @relation("EpisodeSourceWork", fields: [sourceWorkId], references: [id], onDelete: SetNull)

  @@unique([workId, order])
  @@index([sourceWorkId])
}

// ---------- 发行 ----------

model Release {
  id          String    @id @default(cuid())
  projectId   String
  platform    String // YouTube | 抖音 | 视频号 | B站 | ...
  url         String?
  status      String    @default("PENDING") // PENDING | PUBLISHED
  publishedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// 创作者自己的站外账号(OAuth)。钱进这个账号,不经 ComicLaw。
// ownerType 目前只有 user(Auth0 sub);Google 授权必须人在浏览器里点。
model ExternalAccount {
  id              String    @id @default(cuid())
  ownerType       String // user
  ownerId         String // Auth0 sub
  platform        String // youtube
  channelId       String?
  channelTitle    String?
  refreshToken    String // AES-GCM,见 youtubeCrypto
  accessToken     String?
  accessExpiresAt DateTime?
  scopes          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([ownerType, ownerId, platform])
  @@index([ownerId, platform])
}

// ---------- 生成任务 ↔ 扣款交易 关联 ----------

// 不是账本:Credits 的余额、入账、幂等防重全部由 AgentPlanet 的
// /api/internal/wallet/charge 权威负责(它自己写 Transaction、自己按
// idempotency_key 去重)。这张表只记"这次生成动作(jobId)对应哪笔
// AgentPlanet 交易",纯粹是本地排障用的关联指针——查一个项目做了哪些
// 生成动作、对应哪个 transactionId——不重复维护"扣了多少钱"这份真相,
// 避免跟 AgentPlanet 的权威记录双写不一致。
model GenerationChargeRef {
  id            String   @id @default(cuid())
  projectId     String
  userSub       String // 付款客户(Auth0 sub),便于按用户排查,不是余额字段
  jobId         String   @unique // 即传给 AgentPlanet 的 idempotency_key
  amount        Int? // 本次请求金额,仅供排障参考;权威金额见 AgentPlanet Transaction
  action        String? // script_gen | asset_generate | shot_generate | video_generate | post_production
  provider      String? // 上游服务,如 seedance / jimeng
  status        String // SUCCESS | INSUFFICIENT_BALANCE | ERROR
  transactionId String? // AgentPlanet 返回的 transaction_id(仅 SUCCESS 有)
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userSub])
}

// ---------- 站内对话(comiclaw 嵌入式聊天) ----------

// 每人每天的消息计数,用于限额。用 DB 而不是内存计数,因为 Vercel
// serverless 实例是短生命周期、多实例的,内存计数在实例间不一致。
model ChatUsage {
  userSub String
  day     String // UTC 日期,格式 YYYY-MM-DD
  count   Int    @default(0)

  updatedAt DateTime @updatedAt

  @@id([userSub, day])
}
